# Environment Variables Template for Production
# Copy this file to .env.local and fill in your actual values

# ================================
# MongoDB Configuration
# ================================
# Get from: MongoDB Atlas → Database → Connect → Connect your application
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/ecwoc-2025?retryWrites=true&w=majority
MONGODB_URI_LEADERBOARD=
# ================================
# NextAuth Configuration
# ================================
# For production, use your actual domain (e.g., https://ecwoc.com)
# For development, use http://localhost:3000
NEXTAUTH_URL=https://your-domain.com

# Generate with: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=your-super-secret-key-minimum-32-characters-long

# ================================
# Google OAuth
# ================================
# Get from: https://console.cloud.google.com/
# APIs & Services → Credentials → Create OAuth Client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ================================
# GitHub OAuth
# ================================
# Get from: https://github.com/settings/developers
# OAuth Apps → New OAuth App
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret

# ================================
# Email Service - Resend (Primary)
# ================================
# Get from: https://resend.com/api-keys
# Create API Key → Copy the key (starts with re_)
RESEND_API_KEY=re_your_resend_api_key_here

# ================================
# Email Service - Gmail SMTP (Fallback)
# ================================
# Get app password from: https://myaccount.google.com/apppasswords
# Enable 2FA first, then generate app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password-16-chars

# ================================
# Admin Configuration
# ================================
# Change this from the default password for security
ADMIN_PASSWORD=ECWoC2025Admin

# ================================
# Optional: Production Overrides
# ================================
# Uncomment and set these for production-specific settings

# NODE_ENV=production
# NEXT_TELEMETRY_DISABLED=1